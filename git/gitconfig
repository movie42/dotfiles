[core]
	excludesfile = ~/.gitignore_global
	editor = /usr/bin/vim
[init]
	defaultBranch = main
[alias]
	s = status -sb
	ss = !git status -sb && echo && git diff --stat
	l = log --oneline --graph --decorate -20
[color]
	ui = true
[column]
	ui = auto
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[include]
	path = ~/.gitconfig.local
